  priorityLabel: "\uCD5C\uC6B0\uC120!"
  alarmText: "\uD2B9\uBCC4 \uC190\uB2D8 \uB4F1\uC7A5 (\uC120\uC7A5)"
  successToast: "\uC120\uC7A5\uC774 \uD06C\uAC8C \uB9CC\uC871\uD588\uB2E4! \uC624\uB298
    \uC218\uC775\uC774 \uB450 \uBC30\uAC00 \uB41C\uB2E4"
  failToast: "\uC120\uC6D0\uB4E4\uC774 \uB370\uD06C\uB97C \uBD80\uC218\uACE0 \uB5A0\uB0AC\uB2E4\u2026"
  captainOrderLines:
  - "{0}. \uC774 \uAC00\uAC8C \uCD5C\uACE0\uC758 \uC19C\uC528\uB85C \uAC00\uC838\uC640\uB77C."
  - "{0}. \uCD5C\uACE0\uC758 \uC19C\uC528\uB85C \uBD80\uD0C1\uD558\uC9C0."
  crewArriveLines:
  - "\uC6B0\uB9AC \uC120\uC7A5\uB2D8\uC740 \uCD5C\uACE0\uC758 \uC694\uB9AC\uB9CC
    \uB4DC\uC2E0\uB2E4!"
  - "S\uAE09\uC774 \uC544\uB2C8\uBA74 \uAC01\uC624\uD574\uB77C!"
  - "\uC120\uC7A5\uB2D8\uC744 \uAE30\uB2E4\uB9AC\uAC8C \uD558\uC9C0 \uB9C8\uB77C!"
  crewArriveInterval: 2.5
  captainWaitLines:
  - "{0}{1} \uC544\uC9C1\uC778\uAC00? \uB0B4 \uC778\uB0B4\uC2EC\uC744 \uC2DC\uD5D8\uD558\uC9C0
    \uB9C8\uB77C."
  - "\uC120\uC7A5\uC744 \uAE30\uB2E4\uB9AC\uAC8C \uD558\uB2E4\uB2C8, \uBC30\uC9F1
    \uD55C\uBC88 \uC88B\uAD70."
  - "\uB0B4 \uBD80\uD558\uB4E4\uC774 \uC2AC\uC2AC \uCC38\uC9C0 \uBABB\uD558\uB294\uAD70\u2026"
  captainSuccessLines:
  - "\uD6CC\uB96D\uD558\uAD70! \uC18C\uBB38\uB300\uB85C\uC57C."
  captainTreatLines:
  - "\uB108\uD76C\uB3C4 \uBA39\uC5B4\uB77C!"
  - "\uB2E4\uB4E4 \uC549\uC544\uB77C, \uC624\uB298\uC740 \uB0B4\uAC00 \uC0B0\uB2E4!"
  crewSuccessLines:
  - "\uC5ED\uC2DC \uC18C\uBB38\uB300\uB85C\uAD70!"
  - "\uC120\uC7A5\uB2D8\uC774 \uC6C3\uC73C\uC168\uB2E4!"
  - "\uC624\uB298\uC740 \uC2E4\uCEF7 \uBA39\uC790!"
  captainFailLines:
  - "\uC774\uAC78 \uC694\uB9AC\uB77C\uACE0 \uB0B4\uB193\uC740 \uAC74\uAC00!"
  captainNoFoodLines:
  - "\uAC10\uD788 \uC120\uC7A5\uC744 \uAE30\uB2E4\uB9AC\uAC8C \uD574?"
  - "\uC774 \uAC00\uAC8C\uB294 \uC190\uB2D8\uC744 \uAD76\uAE30\uB294\uAD70!"
  crewFailLines:
  - "\uC774\uB534 \uAC78 \uC120\uC7A5\uB2D8\uAED8!"
  - "\uBD80\uC234 \uBC84\uB824!"
  - "\uAC00\uC790, \uC774\uB7F0 \uAC00\uAC8C\uB294 \uD544\uC694 \uC5C6\uB2E4!"
