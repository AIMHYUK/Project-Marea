  m_Script: {fileID: 11500000, guid: d8e6b1da1fd7a9c4c8d5a41bfe9a2b4c, type: 3}
  m_Name: HelpBook
  m_EditorClassIdentifier: Assembly-CSharp::Marea.Data.HelpBook
  categories:
  - "\uAE30\uBCF8"
  - "\uC2DD\uB2F9 \uC601\uC5C5"
  - "\uC7AC\uB8CC \uC218\uAE09"
  - "\uC694\uB9AC"
  - "\uC2DD\uB2F9 \uC131\uC7A5"
  - "\uB3CC\uBC1C \uC0C1\uD669"
  topics:
  - title: "\uC774\uB3D9\uACFC \uC0C1\uD638\uC791\uC6A9"
    category: "\uAE30\uBCF8"
    pages:
    - image: {fileID: 21300000, guid: 6d750016749089140aab6e07a181ff57, type: 3}
      text: "WASD \uD0A4\uB85C \uAC77\uAC70\uB098 \uBC14\uB2E5\uC744 \uB9C8\uC6B0\uC2A4
        \uC67C\uCABD \uBC84\uD2BC\uC73C\uB85C \uD074\uB9AD\uD574 \uC6D0\uD558\uB294
        \uACF3\uC73C\uB85C \uC774\uB3D9\uD558\uC138\uC694.\n\uC870\uB9AC\uB300\xB7\uC190\uB2D8\xB7\uBC2D\uCC98\uB7FC
        \uC774\uC6A9\uD560 \uB300\uC0C1\uC744 \uD074\uB9AD\uD558\uBA74 \uC55E\uAE4C\uC9C0
        \uC774\uB3D9\uD574 \uC0AC\uC6A9\uD569\uB2C8\uB2E4. \uAC00\uAE4C\uC6B4 \uB300\uC0C1\uC5D0
        [E] \uD45C\uC2DC\uAC00 \uB728\uBA74 E \uD0A4\uB85C \uBC14\uB85C \uC0AC\uC6A9\uD560
        \uC218 \uC788\uC5B4\uC694.\n\uB9C8\uC6B0\uC2A4 \uD720\uB85C \uCE74\uBA54\uB77C
        \uAC70\uB9AC\uB97C \uC870\uC808\uD558\uACE0, \uC624\uB978\uCABD \uBC84\uD2BC\uC744
        \uB204\uB978 \uCC44 \uB04C\uC5B4 \uCE74\uBA54\uB77C \uBC29\uD5A5\uC744 \uBC14\uAFC0
        \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    quote: "\uC8FC\uBC29\uC5D0\uB9CC \uC11C \uC788\uC9C0 \uB9D0\uACE0 \uC8FC\uBCC0\uB3C4
      \uB458\uB7EC\uBCF4\uB834. \uD544\uC694\uD55C \uACF3\uC744 \uD074\uB9AD\uD558\uBA74
      \uADF8\uACF3\uAE4C\uC9C0 \uCC3E\uC544\uAC08 \uC218 \uC788\uB2E8\uB2E4."
  - title: "\uCC3D\uACFC \uB2E8\uCD95\uD0A4"
    category: "\uAE30\uBCF8"
    pages:
    - image: {fileID: 21300000, guid: 9fd1c91349a2fda4fb0161ac5569ebf8, type: 3}
      text: "\uC67C\uCABD \uC544\uB798 [\uBA54\uB274]\uC5D0\uC11C \uD0D0\uC0AC\uC815\xB7\uCC3D\uACE0\xB7\uC131\uC7A5\xB7\uB3C4\uC6C0\uB9D0
        \uCC3D\uC744 \uC5F4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD544\uC694\uD55C \uC815\uBCF4\uB97C
        \uD655\uC778\uD558\uBA70 \uC601\uC5C5\uC744 \uC900\uBE44\uD558\uC138\uC694.\nTab:
        \uCC3D\uACE0 \uC5F4\uAE30 / U: \uC2DC\uC124 \uC131\uC7A5 \uC5F4\uAE30 / Esc:
        \uCC3D \uB2EB\uAE30"
    quote: "\uBC14\uBE60\uC9C8\uC218\uB85D \uAE30\uC5B5\uC5D0\uB9CC \uC758\uC9C0\uD558\uC9C0
      \uB9D0\uB834. \uD544\uC694\uD55C \uC815\uBCF4\uB97C \uD655\uC778\uD558\uB294
      \uC2B5\uAD00\uC774 \uC2E4\uC218\uB97C \uC904\uC5EC\uC900\uB2E8\uB2E4."
  - title: "\uD558\uB8E8\uC758 \uD750\uB984"
    category: "\uAE30\uBCF8"
    pages:
    - image: {fileID: 21300000, guid: 3381f7faaddc8f94a9e7463aee767f95, type: 3}
      text: "\uD558\uB8E8\uB294 \uC900\uBE44 \u2192 \uC601\uC5C5 \u2192 \uC815\uC0B0
        \uC21C\uC11C\uB85C \uC9C4\uD589\uB429\uB2C8\uB2E4. \uC790\uC720\uB86D\uAC8C
        \uC7AC\uB8CC\uC640 \uC2DC\uC124\uC744 \uC900\uBE44\uD558\uACE0, \uC900\uBE44\uAC00
        \uB05D\uB098\uBA74 \uC601\uC5C5\uC744 \uC2DC\uC791\uD558\uC138\uC694.\n\uC815\uC0B0\uC744
        \uD655\uC778\uD558\uBA74 \uB2E4\uC74C \uB0A0\uB85C \uB118\uC5B4\uAC00\uBA70,
        \uC774\uB54C \uC77C\uCC28\xB7\uACE8\uB4DC\xB7\uC2DC\uC124 \uC0C1\uD0DC\uAC00
        \uC800\uC7A5\uB429\uB2C8\uB2E4."
    quote: "\uD558\uB8E8\uB97C \uB9C8\uCCE4\uB2E4\uBA74 \uC815\uC0B0\uAE4C\uC9C0
      \uAF2D \uC0B4\uD3B4\uBCF4\uB834. \uC624\uB298\uC758 \uC0B4\uB9BC\uC744 \uC815\uB9AC\uD574\uC57C
      \uB0B4\uC77C\uB3C4 \uB4E0\uB4E0\uD558\uAC8C \uC2DC\uC791\uD560 \uC218 \uC788\uB2E8\uB2E4."
  - title: "\uC601\uC5C5 \uC2DC\uC791\xB7\uC885\uB8CC"
    category: "\uC2DD\uB2F9 \uC601\uC5C5"
    pages:
    - image: {fileID: 21300000, guid: 1f2ad201b5679cc45a1b2a810bb52c4e, type: 3}
      text: "\uC7AC\uB8CC \uC900\uBE44\uAC00 \uB05D\uB0AC\uB2E4\uBA74 \uC6D0\uD558\uB294
        \uB54C\uC5D0 \uC601\uC5C5\uC744 \uC2DC\uC791\uD558\uC138\uC694. \uC601\uC5C5\uC744
        \uC2DC\uC791\uD558\uBA74 \uC190\uB2D8\uB4E4\uC774 \uCC3E\uC544\uC624\uACE0,
        \uB0A8\uC740 \uC601\uC5C5\uC2DC\uAC04\uC774 \uC904\uC5B4\uB4ED\uB2C8\uB2E4.
        \uC601\uC5C5\uC774 \uB05D\uB098\uBA74 \uC815\uC0B0\uC744 \uD655\uC778\uD558\uACE0
        \uB2E4\uC74C \uB0A0\uC758 \uC601\uC5C5\uC744 \uC900\uBE44\uD560 \uC218 \uC788\uC5B4\uC694."
    quote: "\uBB38\uC744 \uC5F4\uAE30 \uC804\uC5D0 \uC7AC\uB8CC\uBD80\uD130 \uC0B4\uD3B4\uBCF4\uB834.
      \uC190\uB2D8\uC774 \uCC3E\uC544\uC628 \uB4A4\uC5D0\uB294 \uC815\uC2E0\uC5C6\uC774
      \uBC14\uBE60\uC9C8 \uD14C\uB2C8\uAE4C!"
  - title: "\uC190\uB2D8"
    category: "\uC2DD\uB2F9 \uC601\uC5C5"
    pages:
    - image: {fileID: 21300000, guid: 78277b65f541d874eafbe9b3d4e9e3e5, type: 3}
      text: "\uC190\uB2D8\uB4E4\uC740 \uBC30\uB97C \uD0C0\uACE0 \uC2DD\uB2F9\uC5D0
        \uCC3E\uC544\uC635\uB2C8\uB2E4. \uC791\uC740 \uBC30\uC5D0\uB294 2\uBA85,
        \uC911\uAC04 \uBC30\uC5D0\uB294 5\uBA85, \uD070 \uBC30\uC5D0\uB294 10\uBA85\uC774
        \uD0C0\uACE0 \uC788\uC5B4\uC694.\n\uC190\uB2D8\uC740 \uC624\uB298\uC758 \uBA54\uB274
        \uC911 \uD558\uB098\uB97C \uC8FC\uBB38\uD569\uB2C8\uB2E4. 60\uCD08 \uC548\uC5D0
        \uC8FC\uBB38\uD55C \uC74C\uC2DD\uC744 \uBC1B\uC9C0 \uBABB\uD558\uAC70\uB098
        \uB2E4\uB978 \uC74C\uC2DD\uC744 \uAC74\uB124\uBC1B\uC73C\uBA74 \uB5A0\uB098\uB2C8,
        \uC8FC\uBB38\uACFC \uB0A8\uC740 \uC2DC\uAC04\uC744 \uD568\uAED8 \uC0B4\uD3B4\uBCF4\uC138\uC694."
    quote: "\uBA40\uB9AC\uC11C \uC624\uB294 \uBC30\uB97C \uB208\uC5EC\uACA8\uBCF4\uB834.
      \uD070 \uBC30\uAC00 \uBCF4\uC778\uB2E4\uBA74 \uC870\uAE08 \uB354 \uBC14\uBE60\uC9C8
      \uC900\uBE44\uB97C \uD574\uC57C\uACA0\uC9C0?"
  - title: "\uB2E8\uCCB4 \uC190\uB2D8"
    category: "\uC2DD\uB2F9 \uC601\uC5C5"
    pages:
    - image: {fileID: 21300000, guid: e9a6f1c97b315e049baacfd5f055f5f5, type: 3}
      text: "\uD55C \uBC30\uB97C \uD0C0\uACE0 \uD568\uAED8 \uCC3E\uC544\uC628 \uC190\uB2D8\uB4E4\uC785\uB2C8\uB2E4.
        \uC601\uC5C5\uC2DC\uAC04 \uC548\uC5D0 \uD574\uB2F9 \uC190\uB2D8\uB4E4\uC758
        \uC8FC\uBB38\uC744 \uBAA8\uB450 \uCC98\uB9AC\uD558\uBA74, \uB2E8\uCCB4 \uC190\uB2D8
        \uB9E4\uCD9C\uC5D0 \uCD94\uAC00 \uBCF4\uB108\uC2A4\uAC00 \uC801\uC6A9\uB429\uB2C8\uB2E4."
    quote: "\uD55C\uAEBC\uBC88\uC5D0 \uCC3E\uC544\uC640\uB3C4 \uB2F9\uD669\uD558\uC9C0
      \uB9D0\uB834. \uBAA8\uB450 \uC798 \uB300\uC811\uD558\uACE0 \uB098\uBA74 \uADF8\uB9CC\uD07C
      \uBCF4\uB78C\uB3C4 \uD074 \uAC70\uC57C."
  - title: "\uD2B9\uBCC4 \uC190\uB2D8"
    category: "\uC2DD\uB2F9 \uC601\uC5C5"
    pages:
    - image: {fileID: 21300000, guid: 5fc2dd61f2daafa4c87b378166eb268b, type: 3}
      text: "\uD2B9\uBCC4\uD55C \uBC30\uB97C \uD0C0\uACE0 \uCC3E\uC544\uC624\uB294
        \uAE4C\uB2E4\uB85C\uC6B4 \uC190\uB2D8\uC785\uB2C8\uB2E4. \uC81C\uD55C\uC2DC\uAC04
        \uC548\uC5D0 \uCD5C\uACE0 \uB4F1\uAE09\uC758 \uC694\uB9AC\uB97C \uB9CC\uB4E4\uC5B4
        \uC9C1\uC811 \uB300\uC811\uD574\uC57C \uD574\uC694. \uC694\uAD6C\uB97C \uCDA9\uC871\uD558\uC9C0
        \uBABB\uD558\uBA74 \uB09C\uB3D9\uC744 \uD53C\uC6B8 \uC218 \uC788\uC73C\uB2C8
        \uC8FC\uC758\uD558\uC138\uC694."
    quote: "\uC131\uBBF8\uAC00 \uAE09\uD55C \uC190\uB2D8\uC774\uAD6C\uB098. \uC11C\uB450\uB974\uB418,
      \uC694\uB9AC\uC758 \uB9DB\uAE4C\uC9C0 \uB193\uCCD0\uC11C\uB294 \uC548 \uB41C\uB2E8\uB2E4!"
  - title: "\uC815\uC0B0"
    category: "\uC2DD\uB2F9 \uC601\uC5C5"
    pages:
    - image: {fileID: 21300000, guid: acef768ff8c120f4783e0216b056ed47, type: 3}
      text: "\uC601\uC5C5\uC744 \uB9C8\uCE58\uBA74 \uADF8\uB0A0\uC758 \uB9E4\uCD9C\uACFC
        \uD310\uB9E4\uD55C \uC74C\uC2DD \uC218, \uC694\uB9AC \uACB0\uACFC \uB4F1\uC744
        \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uCD5C\uC885 \uC218\uC775\uC740
        \uB9E4\uCD9C\uC5D0 \uC815\uC0B0 \uBC30\uC728 \uBCF4\uB108\uC2A4\uB97C \uB354\uD558\uACE0
        \uC9C1\uC6D0 \uC778\uAC74\uBE44\uB97C \uBE80 \uAE08\uC561\uC785\uB2C8\uB2E4.
        \uC9C1\uC6D0\uC744 \uACE0\uC6A9\uD588\uB2E4\uBA74 \uD558\uB8E8 20G\uC758
        \uC778\uAC74\uBE44\uAC00 \uBE60\uC838\uC694.\n\uC815\uC0B0\uC73C\uB85C \uC5BB\uC740
        \uB3C8\uC740 \uB2E4\uC74C \uC601\uC5C5\uC744 \uC900\uBE44\uD558\uAC70\uB098
        \uC2DD\uB2F9\uC744 \uAC1C\uC120\uD558\uB294 \uB370 \uC0AC\uC6A9\uD558\uC138\uC694."
    quote: "\uC5BC\uB9C8\uB97C \uBC8C\uC5C8\uB294\uC9C0\uB3C4 \uC911\uC694\uD558\uC9C0\uB9CC,
      \uADF8 \uB3C8\uC73C\uB85C \uBB34\uC5C7\uC744 \uD560\uC9C0\uB3C4 \uC0DD\uAC01\uD574\uBCF4\uB834.
      \uC2DD\uB2F9\uC740 \uADF8\uB807\uAC8C \uC870\uAE08\uC529 \uC790\uB77C\uB294
      \uAC70\uB780\uB2E4."
  - title: "\uC11C\uBE59 \uC9C1\uC6D0"
    category: "\uC2DD\uB2F9 \uC601\uC5C5"
    pages:
    - image: {fileID: 21300000, guid: bd2349bac43d7fa4fa2365a34ae4a86a, type: 3}
      text: "\uD63C\uC790 \uAC00\uAC8C\uB97C \uC6B4\uC601\uD558\uAE30 \uD798\uB4E4\uB2E4\uBA74
        \uC11C\uBE59 \uC9C1\uC6D0\uC744 \uACE0\uC6A9\uD574\uBCF4\uC138\uC694! \uC9C1\uC6D0\uC774
        \uC644\uC131\uB41C \uC74C\uC2DD\uC744 \uC190\uB2D8\uC5D0\uAC8C \uC804\uB2EC\uD558\uB294
        \uB3D9\uC548, \uC694\uB9AC\uC5D0 \uC9D1\uC911\uD574 \uB354 \uB9CE\uC740 \uC190\uB2D8\uC744
        \uB300\uC811\uD560 \uC218 \uC788\uC5B4\uC694. \uACE0\uC6A9\uD55C \uC9C1\uC6D0\uC758
        \uC778\uAC74\uBE44\uB294 \uD558\uB8E8 500G\uC774\uBA70, \uC815\uC0B0\uD560
        \uB54C \uCC28\uAC10\uB429\uB2C8\uB2E4."
    quote: "\uBAA8\uB4E0 \uC77C\uC744 \uD63C\uC790 \uD574\uB0B4\uB824 \uC560\uC4F0\uC9C0
      \uB9D0\uB834. \uC74C\uC2DD\uC744 \uB098\uB97C \uC190\uC774 \uD558\uB098 \uB298\uBA74,
      \uB108\uB294 \uB9DB\uC788\uB294 \uC694\uB9AC\uC5D0 \uB354 \uB9C8\uC74C\uC744
      \uC3DF\uC744 \uC218 \uC788\uB2E8\uB2E4."
  - title: "\uBCF4\uAE09\uD488"
    category: "\uC7AC\uB8CC \uC218\uAE09"
    pages:
    - image: {fileID: 21300000, guid: 19a9dba75f26c36468ef071c469adcf7, type: 3}
      text: "\uC694\uB9AC\uC5D0 \uD544\uC694\uD55C \uC7AC\uB8CC\uB97C \uBCF4\uAE09\uD488
        \uC0C1\uC790\uC5D0\uC11C \uC5BB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC601\uC5C5
        \uC804\uC5D0 \uBCF4\uC720\uD55C \uC7AC\uB8CC\uB97C \uC0B4\uD3B4\uBCF4\uACE0,
        \uBD80\uC871\uD55C \uC7AC\uB8CC\uB97C \uBCF4\uCDA9\uD558\uC138\uC694."
    quote: "\uBE48 \uC8FC\uBC29\uC73C\uB85C \uC190\uB2D8\uC744 \uB9DE\uC744 \uC218\uB294
      \uC5C6\uACA0\uC9C0? \uC7AC\uB8CC\uAC00 \uBD80\uC871\uD558\uB2E4\uBA74 \uBCF4\uAE09\uD488
      \uC0C1\uC790\uBD80\uD130 \uC0B4\uD3B4\uBCF4\uB834."
  - title: "\uB18D\uC0AC"
    category: "\uC7AC\uB8CC \uC218\uAE09"
    pages:
    - image: {fileID: 21300000, guid: 6363e9a73e4464e468e418ecf7dc95bf, type: 3}
      text: "\uBC2D\uC5D0 \uC791\uBB3C\uC744 \uC2EC\uACE0 \uD0A4\uC6CC \uC694\uB9AC\uC5D0
        \uC0AC\uC6A9\uD560 \uC7AC\uB8CC\uB97C \uC5BB\uC73C\uC138\uC694. \uC790\uB780
        \uC791\uBB3C\uC744 \uC218\uD655\uD558\uBA74 \uC2DD\uB2F9\uC758 \uC7AC\uB8CC\uB85C
        \uD65C\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC601\uC5C5\uC744 \uC900\uBE44\uD558\uB294
        \uB3D9\uC548 \uBC2D\uB3C4 \uD568\uAED8 \uC0B4\uD3B4\uBCF4\uC138\uC694."
    quote: "\uC88B\uC740 \uC7AC\uB8CC\uB97C \uC9C1\uC811 \uD0A4\uC6B0\uB294 \uAC83\uB3C4
      \uC694\uB9AC\uC758 \uC2DC\uC791\uC774\uB780\uB2E4. \uBC2D\uC5D0\uC11C \uC790\uB77C\uB294
      \uC791\uBB3C\uB4E4\uC744 \uC78A\uC9C0 \uB9D0\uACE0 \uC0B4\uD3B4\uBCF4\uB834."
  - title: "\uD0D0\uC0AC\uC815"
    category: "\uC7AC\uB8CC \uC218\uAE09"
    pages:
    - image: {fileID: 21300000, guid: bfb298da945456b4f812174d437f5d8a, type: 3}
      text: "\uD0D0\uC0AC\uC815\uC744 \uBCF4\uB0B4 \uD574\uC5ED\uC758 \uC790\uC6D0\uC744
        \uC5BB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD0D0\uC0AC\uB85C \uC5BB\uC740
        \uD2B9\uC218 \uC790\uC6D0\uC740 \uC2DD\uB2F9\uC758 \uC2DC\uC124\uC744 \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uACE0
        \uC131\uC7A5\uC2DC\uD0A4\uB294 \uB370 \uD544\uC694\uD574\uC694."
    quote: "\uC2DD\uB2F9\uC744 \uB354 \uD0A4\uC6B0\uB824\uBA74 \uB3C8\uB9CC\uC73C\uB85C\uB294
      \uAD6C\uD560 \uC218 \uC5C6\uB294 \uC7AC\uB8CC\uB3C4 \uD544\uC694\uD558\uB2E8\uB2E4.
      \uADF8\uB7F4 \uB550 \uD0D0\uC0AC\uC815\uC758 \uB3C4\uC6C0\uC744 \uBC1B\uC544\uBCF4\uB834."
  - title: "\uC8FC\uBB38\xB7\uB808\uC2DC\uD53C"
    category: "\uC694\uB9AC"
    pages:
    - image: {fileID: 21300000, guid: 53d8fd6a71517c44781c1c2d4b646d7b, type: 3}
      text: "\uC190\uB2D8\uC758 \uC8FC\uBB38\uC744 \uD655\uC778\uD558\uACE0 \uB9CC\uB4E4
        \uC694\uB9AC\uB97C \uC120\uD0DD\uD558\uC138\uC694. \uB808\uC2DC\uD53C\uC5D0\uC11C
        \uD544\uC694\uD55C \uC7AC\uB8CC\uC640 \uC870\uB9AC\uB300\uB97C \uD655\uC778\uD560
        \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC8FC\uBB38\uACFC \uB2E4\uB978 \uC74C\uC2DD\uC744
        \uAC74\uB124\uBA74 \uC190\uB2D8\uC774 \uAC70\uC808\uD558\uACE0 \uB5A0\uB098\uB2C8,
        \uC870\uB9AC \uC804\uC5D0 \uC8FC\uBB38\uC744 \uAF2D \uD655\uC778\uD558\uC138\uC694."
    quote: "\uC798 \uB9CC\uB4E0 \uC694\uB9AC\uB3C4 \uC8FC\uBB38\uACFC \uB2E4\uB974\uBA74
      \uC18C\uC6A9\uC774 \uC5C6\uACA0\uC9C0? \uC190\uB2D8\uC774 \uBB34\uC5C7\uC744
      \uC6D0\uD558\uB294\uC9C0 \uBA3C\uC800 \uC0B4\uD3B4\uBCF4\uB834."
  - title: "\uC870\uB9AC\uB300"
    category: "\uC694\uB9AC"
    pages:
    - image: {fileID: 21300000, guid: 19ba25f86267e3d4d9f20179b525f4e0, type: 3}
      text: "\uC694\uB9AC\uB9C8\uB2E4 \uC0AC\uC6A9\uD558\uB294 \uC870\uB9AC\uB300\uAC00
        \uB2E4\uB985\uB2C8\uB2E4. \uB9CC\uB4E4 \uC694\uB9AC\uC5D0 \uB9DE\uB294 \uC870\uB9AC\uB300\uB97C
        \uCC3E\uC544 \uC870\uB9AC\uB97C \uC2DC\uC791\uD558\uC138\uC694. \uC0C8\uB85C\uC6B4
        \uC870\uB9AC\uB300\uB97C \uD574\uAE08\uD558\uBA74 \uB9CC\uB4E4 \uC218 \uC788\uB294
        \uC694\uB9AC\uC758 \uD3ED\uB3C4 \uB113\uC5B4\uC9D1\uB2C8\uB2E4."
    quote: "\uB3C4\uAD6C\uC5D0\uB3C4 \uC800\uB9C8\uB2E4 \uC798\uD558\uB294 \uC77C\uC774
      \uC788\uB2E8\uB2E4. \uB9CC\uB4E4 \uC694\uB9AC\uC5D0 \uB9DE\uB294 \uC870\uB9AC\uB300\uB97C
      \uACE8\uB77C\uBCF4\uB834."
  - title: "\uC694\uB9AC \uACFC\uC815"
    category: "\uC694\uB9AC"
    pages:
    - image: {fileID: 21300000, guid: 8dad14872ec3ccf42a9e8e5962f5f564, type: 3}
      text: "\uC870\uB9AC\uB300\uB97C \uD074\uB9AD\uD558\uAC70\uB098 \uAC00\uAE4C\uC774\uC5D0\uC11C
        E \uD0A4\uB97C \uB20C\uB7EC \uB9CC\uB4E4 \uC694\uB9AC\uB97C \uC120\uD0DD\uD558\uC138\uC694.
        \uCC3D\uACE0\uC5D0 \uD544\uC694\uD55C \uC7AC\uB8CC\uAC00 \uC788\uC5B4\uC57C
        \uC2DC\uC791\uD560 \uC218 \uC788\uC73C\uBA70, \uC7AC\uB8CC\uB294 \uC694\uB9AC\uAC00
        \uC644\uC131\uB420 \uB54C \uC904\uC5B4\uB4ED\uB2C8\uB2E4.\n\uC694\uB9AC\uB294
        \uC900\uBE44 \u2192 \uD575\uC2EC \uC870\uB9AC \u2192 \uB9C8\uBB34\uB9AC\uC758
        \uC138 \uB2E8\uACC4\uB85C \uC9C4\uD589\uB429\uB2C8\uB2E4. \uBBF8\uB2C8\uAC8C\uC784
        \uD654\uBA74\uC758 \uC548\uB0B4\uC5D0 \uB530\uB77C \uC644\uC131\uD574\uBCF4\uC138\uC694."
    quote: "\uCC98\uC74C\uBD80\uD130 \uB05D\uAE4C\uC9C0 \uC815\uC131\uC744 \uB4E4\uC5EC\uBCF4\uB834.
      \uC7AC\uB8CC\uB97C \uC900\uBE44\uD558\uB294 \uC190\uAE38\uB3C4, \uB9C8\uC9C0\uB9C9
      \uD55C \uBC88\uC758 \uB9C8\uBB34\uB9AC\uB3C4 \uB9DB\uC744 \uBC14\uAFBC\uB2E8\uB2E4."
  - title: "\uC694\uB9AC\uB4F1\uAE09"
    category: "\uC694\uB9AC"
    pages:
    - image: {fileID: 21300000, guid: 028e2c164214ea741b70a2cddbb09ca2, type: 3}
      text: "\uBBF8\uB2C8\uAC8C\uC784 \uACB0\uACFC\uC5D0 \uB530\uB77C \uC694\uB9AC\uC5D0
        S\xB7A\xB7B\xB7F \uB4F1\uAE09\uC774 \uB9E4\uACA8\uC9D1\uB2C8\uB2E4. \uC2E4\uC81C
        \uD310\uB9E4\uAC00\uB294 \uBA54\uB274 \uAE30\uBCF8\uAC00\uC5D0 \uBBF8\uB2C8\uAC8C\uC784
        \uC810\uC218\uB97C \uACF1\uD574 \uACB0\uC815\uB3FC\uC694. \uB354 \uC88B\uC740
        \uC870\uB9AC \uACB0\uACFC\uB97C \uB0B4\uBA74 \uD310\uB9E4 \uBCF4\uC0C1\uB3C4
        \uB192\uC544\uC9D1\uB2C8\uB2E4."
    quote: "\uBE68\uB9AC \uB9CC\uB4DC\uB294 \uAC83\uB9CC\uD07C \uC798 \uB9CC\uB4DC\uB294
      \uAC83\uB3C4 \uC911\uC694\uD558\uB2E8\uB2E4. \uC775\uC219\uD574\uC9C8\uC218\uB85D
      \uD55C \uB2E8\uACC4 \uB354 \uC88B\uC740 \uC694\uB9AC\uC5D0 \uB3C4\uC804\uD574\uBCF4\uB834."
  - title: "\uC74C\uC2DD \uC804\uB2EC"
    category: "\uC694\uB9AC"
    pages:
    - image: {fileID: 21300000, guid: e970ca672759f6344b10a981bc6a146d, type: 3}
      text: "\uC644\uC131\uD55C \uC74C\uC2DD\uC740 \uC8FC\uBB38\uD55C \uC190\uB2D8\uC5D0\uAC8C
        \uB300\uC811\uD558\uC138\uC694. \uD2B9\uBCC4 \uC190\uB2D8\uC5D0\uAC8C\uB294
        \uC74C\uC2DD\uC744 \uC9C1\uC811 \uAC00\uC838\uB2E4\uC918\uC57C \uD569\uB2C8\uB2E4.
        \uC804\uB2EC\uD560 \uC190\uB2D8\uACFC \uB0A8\uC740 \uC81C\uD55C\uC2DC\uAC04\uC744
        \uD655\uC778\uD558\uC138\uC694."
    quote: "\uC694\uB9AC\uB294 \uC190\uB2D8\uC5D0\uAC8C \uB2FF\uC544\uC57C \uB05D\uB098\uB294
      \uAC70\uB780\uB2E4. \uD2B9\uBCC4 \uC190\uB2D8\uC5D0\uAC8C\uB294 \uB124\uAC00
      \uC9C1\uC811 \uAC00\uC838\uB2E4\uC8FC\uB294 \uAC83\uB3C4 \uC78A\uC9C0 \uB9D0\uB834."
  - title: "\uC2DC\uC124 \uC5C5\uADF8\uB808\uC774\uB4DC"
    category: "\uC2DD\uB2F9 \uC131\uC7A5"
    pages:
    - image: {fileID: 21300000, guid: b9a826dc1c2ad8746a5097ba68612a8b, type: 3}
      text: "\uB3C8\uACFC \uD544\uC694\uD55C \uC790\uC6D0\uC744 \uC0AC\uC6A9\uD574
        \uC2DC\uC124\uC744 \uAC1C\uC120\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC2DC\uC124\uB9C8\uB2E4
        \uC5C5\uADF8\uB808\uC774\uB4DC \uD6A8\uACFC\uAC00 \uB2E4\uB974\uBBC0\uB85C,
        \uBE44\uC6A9\uACFC \uD6A8\uACFC\uB97C \uD655\uC778\uD558\uACE0 \uD544\uC694\uD55C
        \uC2DC\uC124\uBD80\uD130 \uC120\uD0DD\uD558\uC138\uC694."
    quote: "\uBC88 \uB3C8\uC744 \uC5B4\uB514\uC5D0 \uC4F0\uB290\uB0D0\uC5D0 \uB530\uB77C
      \uC2DD\uB2F9\uC758 \uBAA8\uC2B5\uB3C4 \uB2EC\uB77C\uC9C4\uB2E8\uB2E4. \uC9C0\uAE08
      \uAC00\uC7A5 \uD544\uC694\uD55C \uBCC0\uD654\uBD80\uD130 \uC0DD\uAC01\uD574\uBCF4\uB834."
  - title: "\uAE30\uB2A5\xB7\uB808\uC2DC\uD53C \uD574\uAE08"
    category: "\uC2DD\uB2F9 \uC131\uC7A5"
    pages:
    - image: {fileID: 21300000, guid: 53429a180b7b1e24aba885a6505fc20e, type: 3}
      text: "\uC870\uAC74\uC744 \uB2EC\uC131\uD558\uBA74 \uC0C8\uB85C\uC6B4 \uAE30\uB2A5\uACFC
        \uB808\uC2DC\uD53C\uB97C \uC5F4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD574\uAE08\uC5D0
        \uD544\uC694\uD55C \uC120\uD589 \uC870\uAC74\uACFC \uBE44\uC6A9\uC744 \uD655\uC778\uD558\uACE0,
        \uB2E4\uC74C \uC131\uC7A5 \uBAA9\uD45C\uB97C \uC815\uD574\uBCF4\uC138\uC694."
    quote: "\uC0C8\uB85C\uC6B4 \uC77C\uC744 \uC2DC\uC791\uD558\uB824\uBA74 \uC900\uBE44\uAC00
      \uD544\uC694\uD55C \uBC95\uC774\uC9C0. \uB9C9\uD600 \uC788\uB2E4\uBA74 \uBA3C\uC800
      \uAC16\uCDB0\uC57C \uD560 \uC870\uAC74\uC744 \uC0B4\uD3B4\uBCF4\uB834."
  - title: "\uBD80\uC9C0 \uD655\uC7A5"
    category: "\uC2DD\uB2F9 \uC131\uC7A5"
    pages:
    - image: {fileID: 21300000, guid: 0549c24b9e1f7a44ca09305053d48754, type: 3}
      text: "\uC2DD\uB2F9\uC758 \uBD80\uC9C0\uB97C \uB113\uD600 \uB354 \uB9CE\uC740
        \uACF5\uAC04\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD655\uC7A5\uC5D0
        \uD544\uC694\uD55C \uC870\uAC74\uACFC \uBE44\uC6A9\uC744 \uD655\uC778\uD558\uACE0,
        \uC2DD\uB2F9\uC758 \uC131\uC7A5\uC5D0 \uB9DE\uCDB0 \uC0C8\uB85C\uC6B4 \uACF5\uAC04\uC744
        \uC5F4\uC5B4\uBCF4\uC138\uC694."
    quote: "\uC2DD\uB2F9\uC774 \uC790\uB77C\uBA74 \uB354 \uB113\uC740 \uC790\uB9AC\uAC00
      \uD544\uC694\uD574\uC9C0\uACA0\uC9C0. \uD55C \uBC88\uC5D0 \uC11C\uB450\uB974\uC9C0
      \uB9D0\uACE0 \uCC28\uADFC\uCC28\uADFC \uB113\uD600\uAC00\uB834."
  - title: "\uD30C\uC190 \uBC14\uB2E5\xB7\uC218\uB9AC"
    category: "\uC2DD\uB2F9 \uC131\uC7A5"
    pages:
    - image: {fileID: 21300000, guid: c68b47e38e5f6394993ddc5dce4801ee, type: 3}
      text: "\uD30C\uC190\uB41C \uBC14\uB2E5\uC744 \uC9C0\uB098\uAC00\uBA74 \uB4E4\uACE0
        \uC788\uB358 \uC74C\uC2DD\uC744 \uB5A8\uC5B4\uB728\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
        \uD30C\uC190\uB41C \uAD6C\uC5ED\uC744 \uD074\uB9AD\uD558\uACE0 \uC218\uB9AC\uBE44\uB97C
        \uC9C0\uBD88\uD558\uBA74 \uBC14\uB2E5\uC744 \uACE0\uCE60 \uC218 \uC788\uC5B4\uC694."
    quote: "\uC694\uB9AC \uC19C\uC528\uAC00 \uC88B\uC544\uB3C4 \uBC1C\uBC11\uC774
      \uBD88\uC548\uD558\uBA74 \uACE4\uB780\uD558\uC9C0. \uC74C\uC2DD\uC774 \uC790\uAFB8
      \uC0AC\uB77C\uC9C4\uB2E4\uBA74 \uBC14\uB2E5\uBD80\uD130 \uC0B4\uD3B4\uBCF4\uB834."
  - title: "\uACE0\uB798 \uCDA9\uB3CC"
    category: "\uB3CC\uBC1C \uC0C1\uD669"
    pages:
    - image: {fileID: 21300000, guid: e5cc5248afbc59f4bb2ca9ee6f086405, type: 3}
      text: "\uAC00\uB054 \uACE0\uB798\uAC00 \uC2DD\uB2F9\uC5D0 \uBD80\uB52A\uCE58\uB294
        \uB3CC\uBC1C \uC0C1\uD669\uC774 \uBC1C\uC0DD\uD569\uB2C8\uB2E4. \uCDA9\uB3CC\uB85C
        \uC218\uB9AC\uBE44\uAC00 \uBC1C\uC0DD\uD558\uB2C8, \uC601\uC5C5 \uC218\uC775\uC744
        \uC0AC\uC6A9\uD560 \uB54C \uC608\uC0C1\uCE58 \uBABB\uD55C \uBE44\uC6A9\uB3C4
        \uACE0\uB824\uD558\uC138\uC694."
    quote: "\uBC14\uB2E4 \uC704 \uC2DD\uB2F9\uC5D0\uB294 \uB73B\uBC16\uC758 \uC190\uB2D8\uB3C4
      \uCC3E\uC544\uC628\uB2E8\uB2E4. \uACE0\uB798\uAE4C\uC9C0 \uBC18\uAE38 \uC21C
      \uC5C6\uACA0\uC9C0\uB9CC, \uC218\uB9AC\uD560 \uB3C8\uC740 \uC870\uAE08 \uB0A8\uACA8\uB450\uB834."
  - title: "\uD2B9\uBCC4 \uC190\uB2D8\uC758 \uB09C\uB3D9"
    category: "\uB3CC\uBC1C \uC0C1\uD669"
    pages:
    - image: {fileID: 21300000, guid: 5fc2dd61f2daafa4c87b378166eb268b, type: 3}
      text: "\uD2B9\uBCC4 \uC190\uB2D8\uC758 \uC694\uAD6C\uB97C \uC81C\uD55C\uC2DC\uAC04
        \uC548\uC5D0 \uCDA9\uC871\uD558\uC9C0 \uBABB\uD558\uBA74 \uB09C\uB3D9\uC744
        \uD53C\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD2B9\uBCC4 \uC190\uB2D8\uC774
        \uB4F1\uC7A5\uD558\uBA74 \uC694\uAD6C\uD558\uB294 \uC694\uB9AC\uB4F1\uAE09\uACFC
        \uB0A8\uC740 \uC2DC\uAC04\uC744 \uD655\uC778\uD558\uACE0 \uB300\uC751\uD558\uC138\uC694."
    quote: "\uC800 \uC190\uB2D8\uC740 \uAE30\uB2E4\uB9AC\uB294 \uAC78 \uC88B\uC544\uD558\uC9C0
      \uC54A\uB294 \uBAA8\uC591\uC774\uAD6C\uB098. \uC694\uAD6C\uB97C \uC798 \uC0B4\uD53C\uACE0,
      \uB09C\uB3D9\uC744 \uD53C\uC6B0\uAE30 \uC804\uC5D0 \uB300\uC811\uD574\uBCF4\uB834."
