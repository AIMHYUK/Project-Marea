  rewardGroup: {fileID: 11400000, guid: 5ac7ebc5db4023446a9c110975a4fd67, type: 2}
  displayName: "\uAE4A\uC740 \uBC14\uB2E4"
  unlockKey: AREA_SEA_01
  stories:
  - "\uAE4A\uC740 \uBC14\uB2E4\uC758 \uBB3C\uBE5B\uC740 \uAC70\uC758 \uAC80\uC5C8\uB2E4.
    \uAC70\uB300\uD55C \uADF8\uB9BC\uC790\uAC00 \uBC30 \uBC11\uC744 \uC9C0\uB098\uAC14\uC9C0\uB9CC,
    \uB2E4\uD589\uD788 \uBB34\uC0AC\uD788 \uB3CC\uC544\uC654\uB2E4."
  - "\uB2FB\uC904\uC774 \uB05D\uAE4C\uC9C0 \uB0B4\uB824\uAC00\uB3C4 \uBC14\uB2E5\uC774
    \uBCF4\uC774\uC9C0 \uC54A\uC558\uB2E4. \uC5B4\uB460 \uC18D\uC5D0\uC11C \uBE5B\uB098\uB294
    \uBB34\uC5B8\uAC00\uB97C \uB04C\uC5B4\uC62C\uB838\uB2E4."
  - "\uACE0\uB798\uC758 \uB178\uB7AB\uC18C\uB9AC\uAC00 \uBC24\uC0C8 \uB4E4\uB824\uC654\uB2E4.
    \uC624\uB798 \uAE30\uC5B5\uC5D0 \uB0A8\uC744 \uD0D0\uC0AC\uC600\uB2E4."
